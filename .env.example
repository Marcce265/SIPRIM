APP_NAME=SIPRIM Backend
APP_ENV=development

# true = datos en memoria (se pierden al reiniciar). false = PostgreSQL.
USE_IN_MEMORY_REPOSITORY=false

# Local con Docker: docker compose up -d db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/siprim

# Neon/Supabase: postgresql+psycopg://user:pass@host/dbname?sslmode=require
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Integracion IA/API. La clave real se configura solo en .env o en el hosting.
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=45
