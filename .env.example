APP_NAME=SIPRIM Backend
APP_ENV=development

# El adaptador heredado usa tablas distintas al modelo PMV1. Mantenerlo en memoria
# hasta reemplazarlo por los repositorios de platform_db/economic_db.
USE_IN_MEMORY_REPOSITORY=true

# Compatibilidad temporal del backend existente. Los modulos nuevos deben usar
# exclusivamente la URL de la base que poseen.
DATABASE_URL=postgresql+psycopg://platform_app:platform_dev_only@localhost:5432/platform_db
AUTH_DB_URL=postgresql+psycopg://auth_app:auth_dev_only@localhost:5432/auth_db
PLATFORM_DB_URL=postgresql+psycopg://platform_app:platform_dev_only@localhost:5432/platform_db
ECONOMIC_DB_URL=postgresql+psycopg://economic_app:economic_dev_only@localhost:5432/economic_db
REDIS_URL=redis://localhost:6379/0

# Neon/Supabase: postgresql+psycopg://user:pass@host/dbname?sslmode=require
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Integracion IA/API. La clave real se configura solo en .env o en el hosting.
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=45
